generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Patient {
  id                    String          @id @default(cuid())
  fullName              String
  preferredName         String
  age                   Int
  gender                String
  primaryLanguage       String          @default("en")
  literacyMode          String          @default("simple")
  accessCode            String          @unique
  conditions            String          // JSON array string
  allergies             String          // JSON array string
  emergencyName         String
  emergencyRelationship String
  emergencyPhone        String
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  caregivers            Caregiver[]
  medications           Medication[]
  scheduleItems         ScheduleItem[]
  caregiverNotes        CaregiverNote[]
  adherenceLogs         AdherenceLog[]
}

model Caregiver {
  id           String   @id @default(cuid())
  name         String
  relationship String
  phone        String
  email        String
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

model Medication {
  id                String         @id @default(cuid())
  patientId         String
  patient           Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name              String
  genericName       String
  strength          String
  form              String         // tablet, capsule, liquid, inhaler, drops, injection
  pillColor         String
  pillShape         String         // round, capsule, oval, square
  imprint           String?
  timesPerDay       Int            @default(1)
  scheduledTimes    String         // JSON array string
  timeSlots         String         // JSON array string
  foodRule          String         // with_food, empty_stomach, after_food, no_restriction
  waterRule         String         // full_glass, normal
  warnings          String         // JSON array string
  totalPills        Int            @default(30)
  pillsRemaining    Int            @default(30)
  refillThreshold   Int            @default(5)
  prescribingDoctor String
  doctorPhone       String
  pharmacyName      String
  rxNumber          String
  instructions      String         // JSON object string
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  scheduleItems     ScheduleItem[]
}

model ScheduleItem {
  id            String     @id @default(cuid())
  patientId     String
  patient       Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicationId  String
  medication    Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  timeSlot      String     // morning, afternoon, evening, bedtime
  scheduledTime String     // e.g. "08:00 AM"
  status        String     @default("pending") // pending, taken, snoozed, skipped
  takenAt       String?
  skipReason    String?
  snoozedUntil  String?
  loggedBy      String?    // patient, caregiver
  loggedByName  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model AdherenceLog {
  id             String   @id @default(cuid())
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicationName String
  dosage         String
  action         String   // taken, skipped, snoozed
  timestamp      String
  scheduledFor   String
  loggedBy       String   // patient, caregiver
  loggedByName   String
  notes          String?
  createdAt      DateTime @default(now())
}

model CaregiverNote {
  id            String   @id @default(cuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  caregiverId   String
  caregiverName String
  text          String
  timestamp     String
  pinned        Boolean  @default(false)
  priority      String   @default("normal") // normal, important, emergency
  createdAt     DateTime @default(now())
}

model EducationalArticle {
  id            String   @id @default(cuid())
  category      String   // instructions, storage, safety, interactions, emergency
  title         String   // JSON string
  summary       String   // JSON string
  simpleContent String   // JSON string
  keyTakeaways  String   // JSON array string
  readTime      String
  iconName      String
  createdAt     DateTime @default(now())
}
